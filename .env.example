# PostgreSQL
POSTGRES_DB=support_ticket
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_PORT=5433

# Backend
SERVER_PORT=8080

# Frontend (Docker Compose)
FRONTEND_PORT=3000

# Host-based local development (backend + postgres via compose, frontend via npm run dev)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/support_ticket
SPRING_DATASOURCE_USERNAME=support
SPRING_DATASOURCE_PASSWORD=support

# Host-based local development (frontend)
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Dockerized frontend uses relative /api/v1 proxied by nginx to the backend service.
